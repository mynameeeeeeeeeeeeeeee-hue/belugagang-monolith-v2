ZEEPIN_TOKEN=VOTRE_TOKEN_ZEEPIN_ICI
ZEEPIN_CLIENT_ID=1523413598024761374

# ── Bot BeluGANG Events ───────────────────────────────────────
EVENTS_TOKEN=VOTRE_TOKEN_EVENTS_ICI
EVENTS_CLIENT_ID=1523414380438491157

# ── Bot Honeypot ──────────────────────────────────────────────
HONEYPOT_TOKEN=VOTRE_TOKEN_HONEYPOT_ICI
HONEYPOT_CLIENT_ID=1523436409937985576

# ── Bot CarlBot (Copie) ───────────────────────────────────────
CARLBOT_TOKEN=VOTRE_TOKEN_CARLBOT_ICI
