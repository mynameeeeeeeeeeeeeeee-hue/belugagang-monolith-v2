# ── Dashboard & Backend ───────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/callback
JWT_SECRET=change_me_in_production
